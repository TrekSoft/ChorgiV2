rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }
    function isMember(familyId) {
      return signedIn() && request.auth.uid in familyData(familyId).authorizedUids;
    }
    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }
    function myInvitePath() {
      return invitePath(request.auth.token.email.lower());
    }
    function hasInvite(familyId) {
      return signedIn()
        && exists(myInvitePath())
        && get(myInvitePath()).data.familyId == familyId;
    }

    match /userIndex/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == uid || isMember(resource.data.familyId));
    }

    match /invites/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list: if false;
      allow create: if isMember(request.resource.data.familyId);
      allow update: if isMember(resource.data.familyId)
        && isMember(request.resource.data.familyId);
      allow delete: if isMember(resource.data.familyId)
        || (signedIn() && request.auth.token.email.lower() == email);
    }

    match /families/{familyId} {
      allow read: if isMember(familyId) || hasInvite(familyId);
      allow create: if signedIn() && request.auth.uid == familyId;
      allow update: if isMember(familyId)
        || (hasInvite(familyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorizedUids'])
            && request.auth.uid in request.resource.data.authorizedUids);
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isMember(familyId) || hasInvite(familyId);
        allow create: if isMember(familyId)
          || (hasInvite(familyId) && request.auth.uid == memberUid)
          || (signedIn() && request.auth.uid == familyId && request.auth.uid == memberUid);
        allow update: if isMember(familyId);
        allow delete: if false;
      }

      match /pendingInvites/{email} {
        allow read, write: if isMember(familyId);
        allow delete: if signedIn() && request.auth.token.email.lower() == email;
      }

      match /{sub=**} {
        allow read, write: if isMember(familyId);
      }
    }
  }
}
